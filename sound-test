<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sound Test | Delivery Risk Pro</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>
        body {
            font-family: 'Kanit', sans-serif;
        }

        .btn {
            transition: all 0.2s ease;
        }

        .btn:active {
            transform: scale(0.95);
        }
    </style>
</head>

<body class="min-h-screen bg-slate-950 flex items-center justify-center p-4">

    <main class="w-full max-w-md">

        <!-- HEADER -->
        <div class="text-center mb-8">

            <div
                class="w-20 h-20 mx-auto rounded-3xl
                bg-gradient-to-br from-indigo-500 to-indigo-700
                flex items-center justify-center
                shadow-xl shadow-indigo-950/50"
            >
                <i class="fa-solid fa-volume-high text-3xl text-white"></i>
            </div>

            <h1 class="text-2xl font-black text-white mt-5">
                Sound Test
            </h1>

            <p class="text-sm text-slate-400 mt-2">
                ทดสอบเสียงระบบ Delivery Risk Pro
            </p>

        </div>


        <!-- TEST CARD -->
        <div
            class="bg-slate-900 border border-slate-800
            rounded-3xl p-5 shadow-2xl space-y-4"
        >

            <!-- SUCCESS -->
            <button
                type="button"
                onclick="playSuccess()"
                class="btn w-full p-5 rounded-2xl
                bg-emerald-600 hover:bg-emerald-500
                text-white shadow-lg shadow-emerald-950/30"
            >

                <div class="flex items-center gap-4">

                    <div
                        class="w-12 h-12 rounded-xl
                        bg-white/15
                        flex items-center justify-center"
                    >
                        <i class="fa-solid fa-circle-check text-xl"></i>
                    </div>

                    <div class="text-left">

                        <p class="font-bold text-lg">
                            ส่งสำเร็จ
                        </p>

                        <p class="text-xs text-emerald-100">
                            ทดสอบเสียง meng.mp3
                        </p>

                    </div>

                </div>

            </button>


            <!-- FAILED -->
            <button
                type="button"
                onclick="playFailed()"
                class="btn w-full p-5 rounded-2xl
                bg-rose-600 hover:bg-rose-500
                text-white shadow-lg shadow-rose-950/30"
            >

                <div class="flex items-center gap-4">

                    <div
                        class="w-12 h-12 rounded-xl
                        bg-white/15
                        flex items-center justify-center"
                    >
                        <i class="fa-solid fa-circle-xmark text-xl"></i>
                    </div>

                    <div class="text-left">

                        <p class="font-bold text-lg">
                            ตีกลับ / ปฏิเสธ
                        </p>

                        <p class="text-xs text-rose-100">
                            ทดสอบเสียง failed.mp3
                        </p>

                    </div>

                </div>

            </button>

        </div>


        <!-- STATUS -->
        <div
            id="status"
            class="mt-5 text-center text-sm text-slate-500"
        >
            เลือกปุ่มเพื่อทดสอบเสียง
        </div>

    </main>


    <script>

        function playSuccess() {

            const audio = new Audio('./meng.mp3');

            audio.volume = 1.0;

            audio.play()
                .then(() => {

                    document.getElementById('status').innerText =
                        '🔊 กำลังเล่นเสียง ส่งสำเร็จ (meng.mp3)';

                    console.log('SUCCESS SOUND OK');

                })
                .catch(error => {

                    document.getElementById('status').innerText =
                        '❌ เล่น meng.mp3 ไม่ได้';

                    console.error(error);

                });

        }


        function playFailed() {

            const audio = new Audio('./failed.mp3');

            audio.volume = 1.0;

            audio.play()
                .then(() => {

                    document.getElementById('status').innerText =
                        '🔊 กำลังเล่นเสียง ตีกลับ (failed.mp3)';

                    console.log('FAILED SOUND OK');

                })
                .catch(error => {

                    document.getElementById('status').innerText =
                        '❌ เล่น failed.mp3 ไม่ได้';

                    console.error(error);

                });

        }

    </script>

</body>
</html>
